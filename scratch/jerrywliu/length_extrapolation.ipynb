   "source": [
    "# BASEDIR=\"/pscratch/sd/j/jwl50/deep_ssm/scripts/icl/p1z306y5/checkpoints\"\n",
    "BASEDIR=\"/pscratch/sd/j/jwl50/deep_ssm/scripts/icl/r1cpg2n4/checkpoints\"\n",
    "\n",
    "L.seed_everything(0)\n",
    "\n",
    "# For a fixed data k\n",
    "k = 40\n",
    "# model_path = \"epoch=4874-step=4875_save.ckpt\"\n",
    "model_path = \"epoch=8563-step=8564.ckpt\"\n",
    "ckpt_path = os.path.join(BASEDIR, model_path)\n",
    "processed_ckpt_path = ckpt_path.split(\".\")[0] + \"_processed.ckpt\"\n",
    "\n",
    "ckpt = torch.load(ckpt_path)\n",
    "state_dict = {k.replace('model._orig_mod', 'model'): v for k, v in ckpt['state_dict'].items()}\n",
    "ckpt['state_dict'] = state_dict\n",
    "torch.save(ckpt, processed_ckpt_path)\n",
    "\n",
    "def get_accs(k, num_eval_iter=None):\n",
    "    args = OmegaConf.load(\"/pscratch/sd/j/jwl50/deep_ssm/configs/icl/baseline_prnn.yaml\")\n",
    "    # args.data_cfg.noise_std = 1\n",
    "    # args.model_cfg.configs.num_iters = 10\n",
    "    # TODO hardcoded num_layers=1\n",
    "    # args.model_cfg.configs.num_layers = 1\n",
    "    args.data_cfg.seq_length = k\n",
    "    if num_eval_iter:\n",
    "        args.model_cfg.configs.num_iters = num_eval_iter\n",
    "    datamodule = InContextLinearRegressionDataModule(args.data_cfg)\n",
    "\n",
    "    # get module and model:\n",
    "    modelito = all_models[args.model_cfg.type](**args.model_cfg.configs)\n",
    "    model = all_modules[args.module_cfg.type](args, modelito)\n",
    "    \n",
    "    # set trainer:\n",
    "    trainer_config = OmegaConf.to_container(args.trainer_cfg)\n",
    "    trainer_config['logger'] = logger\n",
    "\n",
    "    trainer = L.Trainer(**trainer_config, callbacks=local_callbacks, gradient_clip_val=1.0)\n",
    "    wandb.init(mode=\"disabled\")\n",
    "    accs = trainer.test(model, datamodule=datamodule, ckpt_path=processed_ckpt_path)[0]\n",
    "    return accs"
   ]
  },
