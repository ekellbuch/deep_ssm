    "def get_losses_from_acc_dict(d, plot=True):\n",
    "    mses = []\n",
    "    for i in range(len(d.keys())):\n",
    "        mses.append(d[f\"loss_test_{i}\"])\n",
    "    if plot:\n",
    "        plt.plot(range(len(mses)), mses)\n",
    "        plt.ylabel(\"MSE\")\n",
    "        plt.xlabel(\"Number of in-context examples\")\n",
    "        plt.show()\n",
    "    return mses\n",
    "\n",
    "_ = get_losses_from_acc_dict(accs)"
   ]
